---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Marketplaces from '../components/Marketplaces.astro'
import About from '../components/About.astro'
import Services from '../components/Services.astro'
import Journey from '../components/Journey.astro'
import Differentials from '../components/Differentials.astro'
import Coverage from '../components/Coverage.astro'
import Trust from '../components/Trust.astro'
import Faq from '../components/Faq.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'
import Floating from '../components/Floating.astro'
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Marketplaces />
    <About />
    <Services />
    <Journey />
    <Differentials />
    <Coverage />
    <Trust />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <Floating />
  <script>
    import '../scripts/main'
  </script>
</Base>
