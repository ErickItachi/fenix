---
import { marketplaces } from '../data/site'
const row = [...marketplaces, ...marketplaces]
const tags = ['Última milha', 'Entregas no mesmo dia', 'Duas coletas por dia', 'Rastreio ponta a ponta', 'SAC dedicado']
---

<section id="marketplaces" data-section="Marketplaces" class="relative overflow-hidden border-y border-white/10 bg-ink py-14 sm:py-20" aria-labelledby="mk-title">
  <div class="wrap mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <h2 id="mk-title" class="eyebrow text-steel">
      <span class="text-fire">●</span>&nbsp; Marketplaces atendidos
    </h2>
    <p class="max-w-md text-sm text-ash">
      Operamos a última milha de sellers que vendem nos maiores marketplaces do país, e em outros canais de e-commerce.
    </p>
  </div>

  <ul class="sr-only">
    {marketplaces.map((m) => <li>{m}</li>)}
  </ul>

  <div class="relative" aria-hidden="true">
    <div data-marquee="-1" class="flex w-max will-change-transform">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {row.map((name) => (
              <span class="flex items-center">
                <span class="display whitespace-nowrap px-6 text-[clamp(2.5rem,8vw,7.5rem)] text-chrome sm:px-10">{name}</span>
                <svg viewBox="0 0 40 40" class="size-[clamp(1.5rem,4vw,3.5rem)] text-fire" fill="currentColor">
                  <path d="M33 4h6L7 36H1z" />
                </svg>
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <div data-marquee="1" class="mt-4 flex w-max will-change-transform sm:mt-6">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {[...tags, ...tags].map((t) => (
              <span class="flex items-center gap-6 px-6 sm:gap-10 sm:px-10">
                <span class="display text-outline whitespace-nowrap text-[clamp(1.4rem,3.6vw,3rem)] text-steel/80">{t}</span>
                <span class="size-2 rounded-full bg-fire/80" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <p class="wrap mt-10 text-[0.72rem] text-ash">Marcas citadas pertencem aos respectivos titulares. A menção indica os canais de venda atendidos, não uma parceria oficial.</p>
</section>
