---
import { marketplaces, marketplaceLogos } from '../data/site'
const row = [...marketplaceLogos, ...marketplaceLogos]
const tags = ['Última milha', 'Entregas no mesmo dia', 'Duas coletas por dia', 'Rastreio ponta a ponta', 'SAC dedicado']
---

<section id="marketplaces" data-section="Marketplaces" class="relative overflow-hidden border-y border-white/10 bg-ink py-14 sm:py-20" aria-labelledby="mk-title">
  <div class="wrap mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <h2 id="mk-title" class="eyebrow text-steel">
      <span class="text-fire">●</span>&nbsp; Marketplaces atendidos
    </h2>
    <p class="max-w-md text-sm text-ash">
      Operamos a última milha de sellers que vendem nos maiores marketplaces do país, e em outros canais de e-commerce.
    </p>
  </div>

  <ul class="sr-only">
    {marketplaces.map((m) => <li>{m}</li>)}
  </ul>

  <div class="relative" aria-hidden="true">
    <div data-marquee="-1" class="flex w-max items-center will-change-transform">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {row.map((logo) => (
              <span class="flex items-center">
                <span class="mk-cell flex items-center justify-center px-8 sm:px-14">
                  <span
                    class="mk-logo"
                    style={`--src:url(${logo.src}); --k:${logo.scale}; aspect-ratio:${logo.width} / ${logo.height};`}
                  />
                </span>
                <svg viewBox="0 0 40 40" class="size-[clamp(1.1rem,2.6vw,2.2rem)] text-fire/90" fill="currentColor">
                  <path d="M33 4h6L7 36H1z" />
                </svg>
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <div data-marquee="1" class="mt-4 flex w-max will-change-transform sm:mt-6">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {[...tags, ...tags].map((t) => (
              <span class="flex items-center gap-6 px-6 sm:gap-10 sm:px-10">
                <span class="display text-outline whitespace-nowrap text-[clamp(1.4rem,3.6vw,3rem)] text-steel/80">{t}</span>
                <span class="size-2 rounded-full bg-fire/80" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <p class="wrap mt-10 text-[0.72rem] text-ash">Logos e marcas pertencem aos respectivos titulares. A exibição indica os canais de venda atendidos, não uma parceria oficial.</p>
</section>

<style>
  .mk-cell { height: clamp(5.5rem, 13vw, 10rem); }
  /* Silhueta do logo pintada com o mesmo gradiente prata do logotipo da Fênix */
  .mk-logo {
    display: block;
    height: calc(clamp(2.4rem, 5.4vw, 4.6rem) * var(--k));
    background: linear-gradient(180deg, #ffffff 0%, #d9d9d9 40%, #9a9a9a 55%, #e9e9e9 75%, #bdbdbd 100%);
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
    opacity: 0.85;
    transition: opacity 0.5s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
  }
  .mk-cell:hover .mk-logo { opacity: 1; transform: scale(1.04); }
</style>
