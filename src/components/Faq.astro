---
import Button from './Button.astro'
import { faq } from '../data/site'
import { waLink } from '../lib/whatsapp'
---

<section id="faq" data-section="FAQ" data-theme="light" class="relative bg-paper py-24 text-ink sm:py-32 lg:py-40" aria-labelledby="faq-title">
  <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
        <p data-reveal class="eyebrow text-ember">07 — Perguntas frequentes</p>
        <h2 id="faq-title" data-split class="display mt-6 text-[clamp(2.4rem,5vw,4.6rem)]">Tudo o que um seller pergunta.</h2>
        <p data-reveal class="mt-6 max-w-sm text-ink/70">Não encontrou a sua dúvida? O comercial responde pelo WhatsApp.</p>
        <div data-reveal class="mt-8">
          <Button href={waLink('Olá! Tenho uma dúvida sobre os serviços da Fênix Entregas Flex.')} variant="ink" external icon="whatsapp">Perguntar no WhatsApp</Button>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6">
      <ul class="border-t border-ink/15" role="list">
        {
          faq.map((item, i) => (
            <li class="faq-item border-b border-ink/15" data-reveal>
              <h3>
                <button
                  type="button"
                  id={`faq-q-${i}`}
                  aria-expanded="false"
                  aria-controls={`faq-a-${i}`}
                  data-faq
                  class="group flex w-full items-center justify-between gap-6 py-6 text-left sm:py-7"
                >
                  <span class="text-lg font-semibold transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1 sm:text-xl">{item.q}</span>
                  <span class="faq-icon relative grid size-10 shrink-0 place-items-center rounded-full border border-ink/20 transition-all duration-500 group-hover:border-ink group-aria-expanded:border-ember group-aria-expanded:bg-ember">
                    <span class="absolute h-[1.5px] w-3.5 bg-current transition-colors group-aria-expanded:bg-paper" />
                    <span class="faq-v absolute h-3.5 w-[1.5px] bg-current transition-transform duration-500 ease-[var(--ease-out-expo)] group-aria-expanded:rotate-90 group-aria-expanded:bg-paper" />
                  </span>
                </button>
              </h3>
              <div id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} class="faq-answer grid">
                <div class="overflow-hidden">
                  <p class="max-w-2xl pb-7 pr-14 leading-relaxed text-ink/70">{item.a}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .faq-answer { grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease-out-expo); }
  .faq-answer > div > p { opacity: 0; transform: translateY(-6px); transition: opacity 0.4s, transform 0.6s var(--ease-out-expo); }
  .faq-item:has([aria-expanded='true']) .faq-answer { grid-template-rows: 1fr; }
  .faq-item:has([aria-expanded='true']) .faq-answer > div > p { opacity: 1; transform: none; transition-delay: 0.12s; }
  .faq-item:has([aria-expanded='false']) .faq-answer > div { visibility: hidden; transition: visibility 0s 0.6s; }
</style>
