---
import Icon, { type IconName } from './Icon.astro'
import { steps } from '../data/site'

const icons: IconName[] = ['box', 'sort', 'route', 'truck', 'check']
// Estações do percurso no SVG horizontal (viewBox 1600×420)
const stations = [
  { x: 190, y: 262 },
  { x: 500, y: 140 },
  { x: 810, y: 276 },
  { x: 1120, y: 138 },
  { x: 1430, y: 236 },
]
const route =
  'M40 300 C 110 290, 130 262, 190 262 C 320 262, 380 140, 500 140 C 640 140, 680 276, 810 276 C 950 276, 990 138, 1120 138 C 1260 138, 1310 236, 1430 236 C 1500 236, 1540 226, 1570 214'
---

<section id="como-funciona" data-section="Como funciona" class="relative bg-coal" aria-labelledby="jornada-title">
  <div data-journey class="relative overflow-hidden lg:h-[100svh] lg:min-h-[44rem]">
    <div class="grid-lines pointer-events-none absolute inset-0 opacity-80 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]" aria-hidden="true" />
    <span data-journey-count aria-hidden="true" class="display text-outline pointer-events-none absolute -right-4 top-[calc(var(--header-h)+1rem)] hidden select-none text-[22vw] leading-none text-white/[0.06] lg:block">01</span>

    <div class="wrap relative flex h-full flex-col py-24 sm:py-32 lg:justify-between lg:py-0 lg:pb-12 lg:pt-[calc(var(--header-h)+3rem)]">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p data-reveal class="eyebrow text-fire">03 — Como funciona</p>
          <h2 id="jornada-title" data-split class="display mt-6 text-[clamp(2.3rem,5.4vw,5.4rem)] lg:text-[clamp(2.6rem,4.2vw,4.4rem)]">Do ponto de coleta até a porta do cliente.</h2>
        </div>
        <div class="lg:col-span-4">
          <p data-reveal class="text-steel">Acompanhe o percurso de um pacote pela operação Fênix. Cada etapa existe para que o pedido chegue mais rápido e com rastreio.</p>
          <div class="mt-6 hidden items-center gap-4 lg:flex" aria-hidden="true">
            <span class="eyebrow tabular text-paper"><span data-journey-index>01</span> / 05</span>
            <span class="relative h-px flex-1 bg-white/15"><span data-journey-bar class="absolute inset-0 origin-left scale-x-0 bg-fire" /></span>
          </div>
        </div>
      </div>

      <!-- Percurso horizontal (desktop) -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <svg viewBox="0 0 1600 420" class="mx-auto h-[min(34svh,25rem)] w-full overflow-visible" fill="none">
          <defs>
            <linearGradient id="route-g" x1="0" x2="1">
              <stop offset="0" stop-color="#e85d04" /><stop offset=".6" stop-color="#ff6b00" /><stop offset="1" stop-color="#ff8c29" />
            </linearGradient>
            <filter id="route-glow" x="-20%" y="-50%" width="140%" height="200%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
          </defs>
          <path d={route} stroke="rgb(255 255 255 / .14)" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
          <path data-route-glow d={route} stroke="#ff6b00" stroke-width="10" opacity=".55" filter="url(#route-glow)" stroke-linecap="round" />
          <path data-route d={route} stroke="url(#route-g)" stroke-width="3" stroke-linecap="round" />
          {
            stations.map((s, i) => (
              <g data-station={i} transform={`translate(${s.x} ${s.y})`}>
                <circle class="st-pulse" r="34" stroke="#ff6b00" stroke-opacity=".5" />
                <circle class="st-ring" r="34" fill="#111" stroke="rgb(255 255 255 / .2)" stroke-width="1.5" />
                <g transform="translate(-14 -14)" class="st-icon">
                  <Icon name={icons[i]} size={28} stroke={1.5} />
                </g>
                <text y={i % 2 === 0 ? 72 : -56} text-anchor="middle" class="st-label" font-size="15" letter-spacing="2.4" fill="currentColor">
                  {steps[i].tag.toUpperCase()}
                </text>
              </g>
            ))
          }
          <g data-package>
            <circle r="26" fill="#ff6b00" opacity=".25" filter="url(#route-glow)" />
            <g transform="translate(-15 -15)">
              <rect width="30" height="30" rx="6" fill="#ff6b00" />
              <path d="M6 11h18M15 6v8" stroke="#0a0a0a" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
        </svg>
      </div>

      <!-- Etapas -->
      <ol class="relative mt-16 grid gap-0 lg:mt-0 lg:grid-cols-5 lg:gap-6" data-steps>
        <!-- trilha vertical (mobile) -->
        <span aria-hidden="true" class="absolute bottom-6 left-[1.35rem] top-6 w-px bg-white/12 lg:hidden">
          <span data-track class="absolute inset-0 origin-top scale-y-0 bg-gradient-to-b from-ember to-flare" />
          <span data-track-dot class="absolute -left-[7px] top-0 size-[15px] rounded-[4px] bg-fire shadow-[0_0_24px_4px_rgb(255_107_0/0.6)]" />
        </span>
        {
          steps.map((s, i) => (
            <li data-step={i} class="step relative grid grid-cols-[2.75rem_1fr] gap-5 pb-12 last:pb-0 lg:block lg:pb-0">
              <span class="relative z-10 grid size-11 place-items-center rounded-full border border-white/15 bg-coal text-steel transition-colors duration-500 lg:hidden">
                <Icon name={icons[i]} size={20} />
              </span>
              <div class="lg:border-t lg:border-white/15 lg:pt-4">
                <span class="eyebrow step-num text-ash transition-colors duration-500">{String(i + 1).padStart(2, '0')} · {s.tag}</span>
                <h3 class="display mt-3 text-2xl transition-colors duration-500 lg:mt-2 lg:text-xl xl:text-2xl">{s.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-steel transition-opacity duration-500 lg:mt-2 lg:text-[0.82rem] xl:text-sm">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  [data-station] { color: rgb(255 255 255 / 0.4); }
  [data-station] .st-ring, [data-station] .st-icon, [data-station] .st-label { transition: all 0.6s var(--ease-out-expo); }
  [data-station] .st-icon { color: rgb(255 255 255 / 0.45); }
  [data-station] .st-pulse { opacity: 0; transform-box: fill-box; transform-origin: center; }
  [data-station].is-on { color: #f3f3f1; }
  [data-station].is-on .st-ring { stroke: #ff6b00; fill: #1a0e05; }
  [data-station].is-on .st-icon { color: #ff8c29; }
  [data-station].is-current .st-pulse { animation: st-pulse 1.8s var(--ease-out-expo) infinite; }
  @keyframes st-pulse { from { opacity: 0.9; transform: scale(1); } to { opacity: 0; transform: scale(1.9); } }
  .st-label { font-weight: 550; }

  @media (min-width: 1024px) {
    html.motion .step { opacity: 0.38; transition: opacity 0.6s var(--ease-out-expo); }
    html.motion .step.is-on { opacity: 1; }
    .step.is-current .step-num { color: var(--color-fire); }
    .step.is-current > div { border-color: var(--color-fire); }
  }
  @media (max-width: 1023.98px) {
    .step.is-on > span:first-child { border-color: var(--color-fire); color: var(--color-fire); }
    .step.is-on .step-num { color: var(--color-fire); }
  }
</style>
