---
import ServiceArt from './ServiceArt.astro'
import Icon from './Icon.astro'
import Button from './Button.astro'
import { services } from '../data/site'
import { waLink } from '../lib/whatsapp'
---

<section id="servicos" data-section="Serviços" class="relative overflow-hidden bg-ink py-24 sm:py-32 lg:py-40" aria-labelledby="servicos-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p data-reveal class="eyebrow text-fire">02 — Serviços</p>
        <h2 id="servicos-title" data-split class="display mt-6 text-[clamp(2.4rem,6.4vw,6.2rem)]">
          Soluções sob medida para o ritmo do seu e-commerce.
        </h2>
      </div>
      <p data-reveal class="text-steel lg:col-span-4">
        Estrutura operacional, tecnologia e equipe especializada para operações de todos os portes. A solução se ajusta ao volume do seu negócio.
      </p>
    </div>

    <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12" data-services>
      <!-- Lista -->
      <ol class="border-t border-white/10 lg:col-span-7" role="list">
        {
          services.map((s, i) => (
            <li class="service-item border-b border-white/10" data-service={s.id}>
              <button
                type="button"
                class="group flex w-full items-center gap-5 py-7 text-left sm:gap-8 sm:py-9"
                data-service-trigger={i}
                aria-controls={`svc-panel-${s.id}`}
                aria-expanded={i === 0 ? 'true' : 'false'}
              >
                <span class="eyebrow w-8 shrink-0 text-ash transition-colors duration-500 group-aria-expanded:text-fire">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1">
                  <span class="eyebrow mb-2 block !text-[0.62rem] text-ash">{s.kicker}</span>
                  <span class="display block text-[clamp(1.6rem,3.6vw,3.2rem)] text-steel/60 transition-[color,transform] duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-2 group-hover:text-paper group-aria-expanded:text-paper">
                    {s.title}
                  </span>
                </span>
                <span class="grid size-11 shrink-0 place-items-center rounded-full border border-white/15 transition-all duration-500 group-hover:border-fire group-aria-expanded:rotate-45 group-aria-expanded:border-fire group-aria-expanded:bg-fire group-aria-expanded:text-ink">
                  <Icon name="plus" size={18} />
                </span>
              </button>

              <!-- Detalhe no mobile -->
              <div id={`svc-panel-${s.id}`} class="service-detail grid lg:hidden" data-service-detail>
                <div class="overflow-hidden">
                  <div class="pb-9 pl-[3.25rem]">
                    <div class="mb-6 max-w-[18rem] rounded-2xl border border-white/10 bg-graphite p-4">
                      <ServiceArt kind={s.icon} uid="m" />
                    </div>
                    <p class="text-steel">{s.text}</p>
                    <ul class="mt-5 grid gap-2">
                      {s.points.map((p) => (
                        <li class="flex items-start gap-3 text-sm text-paper/85">
                          <Icon name="check" size={16} class="mt-0.5 shrink-0 text-fire" stroke={2} />
                          {p}
                        </li>
                      ))}
                    </ul>
                    <a href={waLink(s.wa)} target="_blank" rel="noopener" class="link-line mt-6 inline-flex items-center gap-2 text-sm font-semibold text-fire">
                      Conversar sobre este serviço <Icon name="arrow" size={16} />
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Painel fixo no desktop -->
      <div class="hidden lg:col-span-5 lg:block">
        <div class="sticky top-[calc(var(--header-h)+2rem)]">
          <div class="relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-graphite">
            <div class="grid-lines absolute inset-0 opacity-70" aria-hidden="true" />
            <div class="relative grid">
              {
                services.map((s, i) => (
                  <article data-service-pane={i} class:list={['service-pane col-start-1 row-start-1 p-8 xl:p-10', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
                    <div class="flex items-center justify-between">
                      <span class="eyebrow text-fire">{s.kicker}</span>
                      <span class="eyebrow text-ash">{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</span>
                    </div>
                    <div class="mx-auto my-6 max-w-[22rem]">
                      <ServiceArt kind={s.icon} uid="d" />
                    </div>
                    <h3 class="display text-2xl xl:text-3xl">{s.title}</h3>
                    <p class="mt-3 text-steel">{s.text}</p>
                    <ul class="mt-5 grid gap-2">
                      {s.points.map((p) => (
                        <li class="flex items-start gap-3 text-sm text-paper/85">
                          <Icon name="check" size={16} class="mt-0.5 shrink-0 text-fire" stroke={2} />
                          {p}
                        </li>
                      ))}
                    </ul>
                    <div class="mt-8">
                      <Button href={waLink(s.wa)} external icon="whatsapp" tabindex={i === 0 ? undefined : '-1'}>
                        Conversar sobre este serviço
                      </Button>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .service-detail { grid-template-rows: 0fr; transition: grid-template-rows 0.7s var(--ease-out-expo); }
  .service-item:has([aria-expanded='true']) .service-detail { grid-template-rows: 1fr; }
  .service-pane { opacity: 0; visibility: hidden; transform: translateY(16px); transition: opacity 0.5s var(--ease-out-expo), transform 0.7s var(--ease-out-expo), visibility 0s 0.5s; }
  .service-pane.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: 0.08s, 0.08s, 0s; }
</style>
<style>
  .service-item:has([aria-expanded='false']) .service-detail > div { visibility: hidden; transition: visibility 0s 0.7s; }
</style>
