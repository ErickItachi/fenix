---
// Ícones em traço único, desenhados para o projeto (24×24, stroke = currentColor).
export type IconName =
  | 'arrow' | 'arrow-down' | 'whatsapp' | 'phone' | 'mail' | 'pin' | 'plus' | 'check'
  | 'instagram' | 'linkedin' | 'facebook' | 'bolt' | 'stack' | 'route' | 'headset' | 'clock' | 'shield' | 'sort' | 'truck' | 'box'

interface Props {
  name: IconName
  size?: number
  class?: string
  stroke?: number
}

const { name, size = 20, class: className, stroke = 1.6 } = Astro.props

const paths: Record<IconName, string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  check: '<path d="M5 12.5l4.2 4.2L19 7"/>',
  phone: '<path d="M6.6 3.5h2.6l1.4 4.1-2 1.5a12.5 12.5 0 0 0 6.3 6.3l1.5-2 4.1 1.4v2.6a2 2 0 0 1-2.1 2A17 17 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21Z"/><circle cx="12" cy="10" r="2.4"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  shield: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6L12 3Z"/><path d="M8.6 12.2l2.4 2.4 4.4-4.6"/>',
  whatsapp:
    '<path d="M4.2 19.8l1.1-3.9A8.6 8.6 0 1 1 8.6 19l-4.4.8Z"/><path d="M9.2 8.6c.2-.5.6-.6.9-.6h.6c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.7l-.5.6c-.1.2-.1.4 0 .6.6 1 1.4 1.8 2.5 2.4.2.1.4.1.6-.1l.6-.6c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.5 0 .9-.6 1.7-1.6 1.9-1 .2-2.7-.3-4.4-1.8-1.6-1.4-2.6-3-2.7-4.1-.1-.9.1-1.6.3-2.1Z" fill="currentColor" stroke="none"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.9"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/>',
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.6v.1M11.5 16v-3.2c0-1.4.9-2.3 2.1-2.3s1.9.9 1.9 2.3V16M11.5 10.5V16"/>',
  facebook: '<path d="M14 21v-7.2h2.6l.4-3H14V9c0-.9.3-1.5 1.6-1.5H17V4.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H8.3v3H11V21"/>',
  sort: '<path d="M4 6h16M4 12h10M4 18h5"/><path d="M17 14v6M14.5 17.5L17 20l2.5-2.5"/>',
  truck: '<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3.5 3.5v2.5h-7.5"/><circle cx="6.5" cy="17.5" r="1.9"/><circle cx="17" cy="17.5" r="1.9"/>',
  box: '<path d="M12 3l8.5 4.5v9L12 21l-8.5-4.5v-9L12 3Z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/>',
  bolt: '<path d="M13.2 2.8L5 13.4h6.2L10.6 21.2 19 10.4h-6.2l.4-7.6Z"/>',
  stack: '<path d="M12 3.2l8.5 4.3L12 11.8 3.5 7.5 12 3.2Z"/><path d="M3.5 12l8.5 4.3 8.5-4.3"/><path d="M3.5 16.5l8.5 4.3 8.5-4.3"/>',
  route: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8.2 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.8"/>',
  headset: '<path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2"/><rect x="3.5" y="13.5" width="4" height="6" rx="1.6"/><rect x="16.5" y="13.5" width="4" height="6" rx="1.6"/><path d="M18.5 19.5c0 1.2-1.6 2-4 2h-1.6"/>',
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
/>
