---
interface Props {
  class?: string
  width?: number
  eager?: boolean
}
const { class: className, width = 160, eager = false } = Astro.props
const height = Math.round((width * 553) / 1909)
---

<img
  src="/brand/fenix-logo-320.webp"
  srcset="/brand/fenix-logo-320.webp 320w, /brand/fenix-logo-640.webp 640w, /brand/fenix-logo-1280.webp 1280w"
  sizes={`${width}px`}
  width={width}
  height={height}
  alt="Fênix Entregas Flex"
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
/>
