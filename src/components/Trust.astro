---
import Icon from './Icon.astro'
import { trust } from '../data/site'
---

<section id="confianca" data-section="Confiança" class="relative overflow-hidden border-t border-white/10 bg-ink py-24 sm:py-32 lg:py-40" aria-labelledby="confianca-title">
  <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p data-reveal class="eyebrow text-fire">06 — Confiança</p>
      <h2 id="confianca-title" data-split class="display mt-6 text-[clamp(2.4rem,5.2vw,5rem)]">Selo de confiança Fênix.</h2>
      <p data-reveal class="mt-6 max-w-md text-steel">
        Agilidade, rastreabilidade e comunicação transparente em cada etapa, do primeiro contato até a confirmação de recebimento pelo cliente final. Tudo o que está aqui você pode verificar.
      </p>

      <div class="relative mt-14 aspect-square w-full max-w-[20rem]" aria-hidden="true" data-parallax="10">
        <svg viewBox="0 0 240 240" class="absolute inset-0 h-full w-full">
          <defs>
            <path id="trust-ring" d="M120,120 m-96,0 a96,96 0 1,1 192,0 a96,96 0 1,1 -192,0" />
          </defs>
          <circle cx="120" cy="120" r="116" fill="none" stroke="rgb(255 255 255 / .12)" />
          <circle cx="120" cy="120" r="78" fill="none" stroke="rgb(255 107 0 / .5)" stroke-dasharray="1 5" />
          <g data-spin>
            <text font-size="11.5" fill="#c9c9c9" font-weight="550">
              <textPath href="#trust-ring" textLength="598" lengthAdjust="spacing">RASTREABILIDADE • COMPROMISSO • AGILIDADE • COMUNICAÇÃO • </textPath>
            </text>
          </g>
        </svg>
        <div class="absolute inset-[30%] grid place-items-center rounded-full bg-fire text-ink shadow-[0_0_80px_-10px_rgb(255_107_0/0.7)]">
          <Icon name="shield" size={56} stroke={1.4} />
        </div>
      </div>
    </div>

    <ul class="lg:col-span-6 lg:col-start-7" role="list">
      {
        trust.map((t, i) => (
          <li data-reveal class="group border-t border-white/10 py-8 last:border-b">
            <div class="flex items-start gap-5">
              <span class="grid size-10 shrink-0 place-items-center rounded-full border border-white/15 text-fire transition-colors duration-500 group-hover:border-fire group-hover:bg-fire group-hover:text-ink">
                <Icon name="check" size={18} stroke={2} />
              </span>
              <div class="flex-1">
                <span class="eyebrow text-ash">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="display mt-2 text-2xl sm:text-3xl">{t.title}</h3>
                <p class="mt-3 text-steel">{t.text}</p>
                <a
                  href={t.href}
                  target={t.href.startsWith('http') ? '_blank' : undefined}
                  rel={t.href.startsWith('http') ? 'noopener' : undefined}
                  class="link-line mt-4 inline-flex items-center gap-2 text-sm font-semibold text-paper"
                >
                  {t.cta} <Icon name="arrow" size={15} class="text-fire transition-transform duration-500 group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
