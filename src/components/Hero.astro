---
import Button from './Button.astro'
import { site, marketplaces } from '../data/site'
import { waLink } from '../lib/whatsapp'
---

<section id="inicio" data-section="Início" class="noise relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink pt-[var(--header-h)]" aria-labelledby="hero-title">
  <!-- Rede de rotas (canvas). O gradiente abaixo é a versão estática. -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_70%_100%,rgb(255_107_0/0.22),transparent_60%)]" />
    <canvas data-hero-canvas class="absolute inset-0 h-full w-full" />
    <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-ink to-transparent" />
    <div class="absolute inset-y-0 left-0 w-full bg-gradient-to-r from-ink/85 via-ink/30 to-transparent lg:w-3/4" />
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent" />
  </div>

  <div data-hero-content class="wrap relative flex flex-1 flex-col justify-center pb-8 pt-8 sm:pt-12">
    <p data-hero-fade style="--i:0" class="eyebrow mb-6 flex items-center gap-3 text-steel sm:mb-8">
      <span class="relative flex size-2.5" aria-hidden="true">
        <span class="absolute inset-0 animate-ping rounded-full bg-fire opacity-70" />
        <span class="relative size-2.5 rounded-full bg-fire" />
      </span>
      Última milha · Grande São Paulo
    </p>

    <h1 id="hero-title" class="display max-w-[15ch] text-[clamp(3rem,min(10.4vw,15.5svh),10rem)]">
      <span data-hero-line class="split-line" style="--i:0"><span class="split-inner block">Seu pedido</span></span>
      <span data-hero-line class="split-line" style="--i:1"><span class="split-inner block"><span class="display-italic text-flame pr-[0.06em]">renasce</span> a</span></span>
      <span data-hero-line class="split-line" style="--i:2"><span class="split-inner block">cada entrega<span class="text-fire">.</span></span></span>
    </h1>

    <div class="mt-8 grid gap-8 sm:mt-10 lg:grid-cols-[minmax(0,34rem)_1fr] lg:items-end">
      <div>
        <p data-hero-fade style="--i:1" class="max-w-[34rem] text-[1.05rem] leading-relaxed text-steel sm:text-lg">
          Entregas rápidas no mesmo dia para quem vende em marketplaces. Coletamos, organizamos por região e levamos cada pacote até a porta do seu cliente, com rastreio e SAC dedicado.
        </p>
        <div data-hero-fade style="--i:2" class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={waLink('Olá! Quero uma proposta de entregas para minha loja.')} external icon="whatsapp" data-wa-context>
            Solicitar proposta
          </Button>
          <Button href="#como-funciona" variant="ghost" icon="arrow-down">Ver como funciona</Button>
        </div>
      </div>

      <dl data-hero-fade style="--i:3" class="grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 backdrop-blur-sm lg:ml-auto lg:w-[30rem]">
        <div class="bg-ink/70 p-3.5 sm:p-5">
          <dt class="eyebrow !text-[0.6rem] text-ash">Coletas</dt>
          <dd class="display mt-2 whitespace-nowrap text-[1.35rem] min-[400px]:text-2xl sm:text-3xl">2<span class="text-fire">×</span></dd>
          <dd class="mt-1 text-xs text-steel">janelas por dia</dd>
        </div>
        <div class="bg-ink/70 p-3.5 sm:p-5">
          <dt class="eyebrow !text-[0.6rem] text-ash">Cobertura</dt>
          <dd class="display mt-2 whitespace-nowrap text-[1.35rem] min-[400px]:text-2xl sm:text-3xl">100<span class="text-fire">%</span></dd>
          <dd class="mt-1 text-xs text-steel">áreas Flex · SP</dd>
        </div>
        <div class="bg-ink/70 p-3.5 sm:p-5">
          <dt class="eyebrow !text-[0.6rem] text-ash">SAC</dt>
          <dd class="display mt-2 whitespace-nowrap text-[1.35rem] min-[400px]:text-2xl sm:text-3xl">{site.sacHours.open.replace('h', '')}<span class="text-fire">–</span>{site.sacHours.close.replace('h', '')}</dd>
          <dd class="mt-1 text-xs text-steel">horário do SAC</dd>
        </div>
      </dl>
    </div>
  </div>

  <div data-hero-fade style="--i:4" class="wrap relative flex items-end justify-between gap-6 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
    <a href="#marketplaces" class="group flex items-center gap-4 text-steel transition-colors hover:text-paper">
      <span class="relative h-12 w-px overflow-hidden bg-white/15" aria-hidden="true">
        <span class="absolute inset-x-0 top-0 h-1/2 animate-[scrollcue_2.2s_var(--ease-in-out-quart)_infinite] bg-fire" />
      </span>
      <span class="eyebrow">Role e acompanhe a entrega</span>
    </a>
    <p class="eyebrow hidden text-ash md:block">
      {marketplaces.join(' · ')}
    </p>
  </div>
</section>

<style>
  @keyframes scrollcue {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }
</style>
